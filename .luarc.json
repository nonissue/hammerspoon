{
  "diagnostics": {
    "globals": [
      "hs",
      "ls",
      "_",
      "assert",
      "assertIsEqual",
      "bind",
      "choice",
      "clear",
      "debug",
      "fw",
      "hostname",
      "hs_config_dir",
      "i",
      "ipairs",
      "mash",
      "math",
      "obj",
      "os",
      "package",
      "pairs",
      "pbcopy",
      "print_r",
      "print_t",
      "print",
      "reload",
      "require",
      "spoon",
      "string",
      "success",
      "table",
      "tonumber",
      "tostring",
      "type"
    ]
  },
  "workspace": {
    "ignoreDir": [
      ".vscode",
      "_archive",
      "Spoons"
    ]
  },
  "format": {
    "defaultConfig": {
      "indent_style": "space",
      "space_before_attribute": "false",
      "space_around_table_field_list": "false"
    }
  }
}